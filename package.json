{
  "name": "pi-remote-control",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.34.7",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "turbo run build",
    "typecheck": "turbo run typecheck",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "dev:bridge": "pnpm --filter @pirc/bridge dev",
    "dev:android": "pnpm --filter mobile android",
    "prepare": "husky",
    "verify": "pnpm typecheck && pnpm lint && pnpm test && pnpm format:check",
    "format:check": "prettier --check .",
    "audit:start": "node .agents/skills/judge/scripts/start-audit.mjs",
    "audit:schedule": "node .agents/skills/judge/scripts/schedule-audits.mjs"
  },
  "lint-staged": {
    "*.{ts,tsx,js,mjs,json,yaml,yml,md,css}": [
      "prettier --write"
    ],
    "{packages,apps/bridge,.agents}/**/*.{ts,js,mjs}": [
      "eslint --fix"
    ]
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.3",
    "@commitlint/config-conventional": "^21.2.3",
    "eslint": "^9.39.5",
    "eslint-plugin-jsdoc": "65.4.2",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "prettier": "^3.9.10",
    "turbo": "^2.11.9",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.2",
    "vitest": "^5.0.5"
  }
}
